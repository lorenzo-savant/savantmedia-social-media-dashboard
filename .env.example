# === Database Postgres ===
# Locale senza password:
DATABASE_URL=postgresql://localhost:5432/savant_ads
# Con utente/password:
# DATABASE_URL=postgresql://utente:password@localhost:5432/savant_ads

# === Meta Marketing API ===
# Lascia vuoti finché non hai l'accesso admin: la dashboard gira su dati seed.
# Quando Rebecca ti aggiunge al Business portfolio, genera un System User token
# (scope ads_read) e incollalo qui.
META_ACCESS_TOKEN=
# Ad account separati da virgola, con prefisso act_ : act_123,act_456
META_AD_ACCOUNTS=

# === Google Ads API ===
# Explorer Access è disponibile subito (nessuna approvazione lenta). Lascia vuoti
# finché non hai le credenziali: il connettore Google semplicemente non gira.
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Manager account (MCC) sotto cui girano le query, solo cifre. Opzionale.
GOOGLE_LOGIN_CUSTOMER_ID=
# Account da leggere, separati da virgola (anche con trattini): 123-456-7890,987-654-3210
GOOGLE_CUSTOMER_IDS=

# === Snapchat Marketing API ===
# Ultimo in ordine di priorità (vedi TILL-REBECCA.md). Il connettore non esiste
# ancora; queste variabili sono già lette dalla dashboard per mostrare, nella
# pagina Konton, cosa manca per arrivare ai dati veri.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=
# Ad account separati da virgola
SNAPCHAT_AD_ACCOUNT_IDS=

# === Opzionali (hanno già un default sensato in config.py) ===
# Versione delle Graph API Meta
# META_API_VERSION=v25.0
# Versione API Google Ads
# GOOGLE_API_VERSION=v24
# Giorni da ri-scaricare a ogni sync (28 = finestra di attribuzione Meta)
# LOOKBACK_DAYS=28
# Soglia % di utilizzo rate limit oltre cui rallentare
# RATE_LIMIT_THROTTLE_PCT=80
