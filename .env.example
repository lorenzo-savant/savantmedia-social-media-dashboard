# === Postgres-databas ===
# Lokalt utan lösenord:
DATABASE_URL=postgresql://localhost:5432/savant_ads
# Med användare/lösenord:
# DATABASE_URL=postgresql://användare:lösenord@localhost:5432/savant_ads

# === Meta Marketing API ===
# Lämna tomma tills du har admin-åtkomst: dashboarden körs på demodata.
# När Rebecca lägger till dig i företagsportföljen, generera en System User-token
# (scope ads_read) och klistra in den här.
META_ACCESS_TOKEN=
# Annonskonton separerade med kommatecken, med prefixet act_ : act_123,act_456
META_AD_ACCOUNTS=

# === Google Ads API ===
# Explorer Access finns direkt (ingen långsam godkännandeprocess). Lämna tomma
# tills du har nycklarna: Google-connectorn körs helt enkelt inte.
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Förvaltarkonto (MCC) som frågorna körs under, endast siffror. Valfritt.
GOOGLE_LOGIN_CUSTOMER_ID=
# Konton att läsa, separerade med kommatecken (även med bindestreck): 123-456-7890,987-654-3210
GOOGLE_CUSTOMER_IDS=

# === Snapchat Marketing API ===
# Sist i prioritetsordningen (se TILL-REBECCA.md). Connectorn finns inte
# ännu; dessa variabler läses redan av dashboarden för att på sidan
# Konton visa vad som saknas för att komma åt skarp data.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=
# Annonskonton separerade med kommatecken
SNAPCHAT_AD_ACCOUNT_IDS=

# === Valfria (har redan ett rimligt standardvärde i config.py) ===
# Version av Metas Graph API
# META_API_VERSION=v25.0
# Version av Google Ads API
# GOOGLE_API_VERSION=v24
# Dagar som hämtas om vid varje synk (28 = Metas attributionsfönster)
# LOOKBACK_DAYS=28
# Tröskel i % av rate limit-användning över vilken synken saktas ner
# RATE_LIMIT_THROTTLE_PCT=80
